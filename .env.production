# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database URL is loaded from AWS Secrets Manager
# DATABASE_URL is not set here for security

# OpenTelemetry (X-Ray in production)
OTEL_SERVICE_NAME=nestjs-template-production
OTEL_TRACES_ENABLED=true

# AWS
AWS_REGION=ap-northeast-1
AWS_SECRETS_MANAGER_SECRET_NAME=nestjs-template/production

# Logging
LOG_LEVEL=warn