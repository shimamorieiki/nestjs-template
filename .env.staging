# Staging Environment Configuration
NODE_ENV=staging
PORT=3000

# Database
DATABASE_URL=postgresql://staging_user:staging_pass@staging-db.example.com:5432/nestjs_template_staging?schema=public

# OpenTelemetry
OTEL_SERVICE_NAME=nestjs-template-staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.staging.example.com:4317
OTEL_TRACES_ENABLED=true

# AWS
AWS_REGION=ap-northeast-1

# Logging
LOG_LEVEL=info